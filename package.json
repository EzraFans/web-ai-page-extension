{
  "name": "web-ai-page-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build -c vite.content.config.ts",
    "dev": "run-p dev:main dev:content",
    "dev:main": "vite build --watch",
    "dev:content": "vite build -c vite.content.config.ts --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-static-copy": "^2.2.0"
  }
}
